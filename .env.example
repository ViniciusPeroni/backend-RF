# Opcionais (comentados para não serem exigidos pelo dotenv-safe).
# Canais externos são opt-in e ficam desligados até configuração explícita.
# NOTIFICATION_EMAIL_ENABLED=false
# NOTIFICATION_PUSH_ENABLED=false
# Chave independente: 32 bytes hexadecimais (64 caracteres). Preservar para ler tokens.
# NOTIFICATION_TOKEN_KEY=
# NOTIFICATION_SMTP_HOST=
# NOTIFICATION_SMTP_PORT=465
# NOTIFICATION_SMTP_USER=
# NOTIFICATION_SMTP_PASS=
# NOTIFICATION_EMAIL_FROM=
# FCM_PROJECT_ID=
# ADC do Google: caminho local de credenciais, nunca conteúdo JSON no repositório.
# GOOGLE_APPLICATION_CREDENTIALS=
